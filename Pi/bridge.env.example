# Copy to bridge.env on the Raspberry Pi and fill in. bridge.env is git-ignored (no passwords in git).
BROKER_HOST=192.168.0.10
BROKER_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
ROBOT_ID=bot-2
SERIAL_PORT=/dev/ttyACM0
# Bench test only: ignore the expiry check (clocks of laptop and Pi not synced yet). Leave 0 for real use.
IGNORE_EXPIRY=0
# Shift this Pi's clock in ms if commands are rejected as stale/future (log shows the measured age).
CLOCK_OFFSET_MS=0
